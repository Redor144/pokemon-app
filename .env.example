# Google Maps API key for Android (Maps SDK for Android must be enabled in Google Cloud Console)
# Restrict the key to package name: com.pokemon.app
# Add your debug SHA-1 from: keytool -list -v -keystore android/app/debug.keystore -alias androiddebugkey -storepass android -keypass android
# (Run `npx expo prebuild --platform android` first if that keystore does not exist yet)
GOOGLE_MAPS_API_KEY=your_key_here
